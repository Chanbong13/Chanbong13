# Database
DATABASE_URL="postgresql://user:password@localhost:5432/lifepilot"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN="your-line-channel-access-token"
LINE_CHANNEL_SECRET="your-line-channel-secret"

# LINE Login (Optional)
LINE_LOGIN_CHANNEL_ID="your-line-login-channel-id"
LINE_LOGIN_CHANNEL_SECRET="your-line-login-channel-secret"

# Strava API (Optional)
STRAVA_CLIENT_ID="your-strava-client-id"
STRAVA_CLIENT_SECRET="your-strava-client-secret"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Anthropic AI (Optional - for AI features)
ANTHROPIC_API_KEY="your-anthropic-api-key"
